# Public demo build: VITE_DEMO=1 bakes in canned topology, no backend needed.
# Served as static files only — no /api or /socket.io proxy (see nginx.demo.conf).
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install
COPY . .
ENV VITE_DEMO=1
RUN npm run build:demo

FROM nginx:alpine
COPY --from=build /app/dist-demo /usr/share/nginx/html
COPY nginx.demo.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
