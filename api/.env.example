# status_dashboard API — environment variables

# Server port
PORT=3002

# Friendly host name shown in the UI (avoids raw container IDs)
HOST_DISPLAY_NAME=gigglin-server

# Netdata base URL for host telemetry + topology charts
NETDATA_URL=http://localhost:19999

# Optional: path to a single nginx config file parsed into public host -> upstream routes
# (e.g. an exported Nginx Proxy Manager config or /etc/nginx/sites-enabled/default)
NGINX_CONF_PATH=

# Optional: Guacamole REST credentials for VM connection nodes
GUAC_URL=
GUAC_USER=
GUAC_PASS=

# Live pulse poll interval (ms)
PULSE_INTERVAL_MS=5000

# Cookie auth (empty = open / dev mode)
DASHBOARD_PASS=
SESSION_SECRET=change-me
